NEXT_PUBLIC_NETWORK=testnet

# The deployed vault contract. Both covered calls and cash-secured puts live in
# this one instance — the kind is a parameter, not a separate deployment.
NEXT_PUBLIC_VAULT_CONTRACT=
# Pricing-engine key that co-signs every position's premium. The contract will
# not open a position without it. It has no custody: it cannot move collateral,
# settle a position, or change one after the fact.
VAULT_QUOTER_SECRET=

NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_XLM_PRICE_FALLBACK=0.10

# Lusty testnet USD
NEXT_PUBLIC_LUSD_CODE=LUSD
NEXT_PUBLIC_LUSD_ISSUER=
NEXT_PUBLIC_LUSD_DISTRIBUTOR=

# Server-side secrets (never commit these)
LUSD_DISTRIBUTOR_SECRET=
LUSD_ISSUER_SECRET=

# Safety catch on the retired server-side payout path (/api/vault/claim POST).
# Unset or anything other than 1 = closed, and no code path can pay out of the
# distributor. Set to 1 only to work through the legacy book left over from
# before contract custody, and turn it off again afterwards. Positions opened on
# the vault contract are unaffected either way: they settle on chain through
# settle(id), which anyone can call. GET on that route reports what is still
# outstanding and needs no flag.
LEGACY_CLAIM_ENABLED=
VAULT_XLM_BASELINE=30000

VAULT_EPOCHS_PER_MONTH=3
VAULT_CALL_MONTHLY_CAP_XLM=1500000
VAULT_PUT_MONTHLY_CAP_USD=150000

# Database
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini AI
GEMINI_API_KEY=

# Fee wallet — protocol revenue goes here (Stellar public key)
FEE_WALLET=

# SSL: set to false only for Supabase connection pooler in dev
DB_SSL_REJECT_UNAUTHORIZED=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Risk monitoring alerts (P1-7) — both channels optional, both best-effort.
# Slack incoming webhook:
MONITOR_SLACK_WEBHOOK_URL=
# Email via Resend (https://resend.com). Comma-separate multiple recipients:
RESEND_API_KEY=
MONITOR_ALERT_EMAIL_TO=
MONITOR_ALERT_EMAIL_FROM=Lusty Monitor <alerts@lusty.finance>
# Label shown in every alert (e.g. testnet / mainnet):
MONITOR_ENV_LABEL=testnet
# Secret for the scheduled endpoints (/api/cron/monitor, /api/cron/settle).
# Vercel cron sends it as a Bearer token; unset = endpoints disabled (fail
# closed):
CRON_SECRET=

# Key the settlement runner signs with (/api/cron/settle). It closes expired
# positions so writers do not have to send the transaction themselves.
#
# This key holds no privilege. `settle` is permissionless: the contract checks
# no caller identity, pays the position's owner, and prices the outcome off the
# oracle reading at expiry — so this account can only pay fees. It cannot move
# collateral, settle to itself, change a limit or sign a premium. Losing it
# costs the fee balance and nothing else, and while it is missing anyone,
# including the writer, can still settle. Unset = the sweep scans and reports
# but submits nothing.
SETTLE_RUNNER_SECRET=
# Monitor thresholds:
MONITOR_CAP_WARN_PCT=90
MONITOR_LATENCY_BUDGET_MS=4000
MONITOR_VOL_SPIKE_MULT=2
# Auto circuit-breaker halt thresholds (P1-8 step 2):
MONITOR_VOL_HALT_MULT=3
MONITOR_ORACLE_JUMP_PCT=10
MONITOR_EPOCH_LOSS_CAP_USD=25000
