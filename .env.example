NEXT_PUBLIC_NETWORK=testnet

# XLM's deployed vault. Calls and puts share the instance; each *underlying*
# gets one of its own. Unset gates XLM, as an unset anchor gates BTC.
NEXT_PUBLIC_VAULT_CONTRACT=
# The SACs that vault was constructed with. Defaults are the testnet ids in
# contracts/README.md; set them when deploying elsewhere.
# NEXT_PUBLIC_XLM_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# NEXT_PUBLIC_LUSD_CONTRACT=CDTMNV7F7P3LUH6LLBTXY4EQYBUYGVGYRC7P73HMFV5PXLO5NE6A74QB
# Superseded instances only, comma separated. Live ones come off the registry.
# NEXT_PUBLIC_VAULT_CONTRACTS=
# Pricing-engine key that co-signs every position's premium. The contract will
# not open a position without it. It has no custody: it cannot move collateral,
# settle a position, or change one after the fact.
VAULT_QUOTER_SECRET=

NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_XLM_PRICE_FALLBACK=0.10

# Lusty testnet USD
NEXT_PUBLIC_LUSD_CODE=LUSD
NEXT_PUBLIC_LUSD_ISSUER=
NEXT_PUBLIC_LUSD_DISTRIBUTOR=

# Server-side secrets (never commit these)
LUSD_DISTRIBUTOR_SECRET=
LUSD_ISSUER_SECRET=

VAULT_XLM_BASELINE=30000

# How far above the quoter's own live quote a requested premium may sit before
# /api/vault/authorize refuses to co-sign, in basis points of the premium. The
# UI's quote is a snapshot and the co-signature reprices, so this absorbs the
# spot tick between them; it is also the protocol's worst-case overpayment on a
# single position. 0 = exact match only (expect refusals on any moving feed).
PREMIUM_SLIPPAGE_BPS=25

VAULT_EPOCHS_PER_MONTH=3
VAULT_CALL_MONTHLY_CAP_XLM=1500000
VAULT_PUT_MONTHLY_CAP_USD=150000
VAULT_MIN_SIZE_XLM=100

# --- BTC underlying (declared in lib/assets, not yet live) -------------------
# BTC stays gated until an anchor is named here: without an issuer there is no
# wrapped BTC to escrow, so the vault refuses to list it rather than quote an
# asset it cannot take custody of.
# NEXT_PUBLIC_BTC_ANCHOR_ISSUER=G...
# NEXT_PUBLIC_BTC_ANCHOR_CODE=BTC
# BTC's own vault and the SAC it escrows. Each gates BTC on its own; there is
# no fallback to XLM's contract.
# NEXT_PUBLIC_VAULT_CONTRACT_BTC=C...
# NEXT_PUBLIC_BTC_CONTRACT=C...
# BTC keeps its own books — these caps are not carved out of the XLM ones.
VAULT_CALL_MONTHLY_CAP_BTC=5
VAULT_PUT_MONTHLY_CAP_USD_BTC=150000
VAULT_MIN_SIZE_BTC=0.001
# Reflector feed each underlying settles against.
# REFLECTOR_FEED_SYMBOL=XLM
# REFLECTOR_FEED_SYMBOL_BTC=BTC

# Database
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini AI
GEMINI_API_KEY=

# Fee wallet — protocol revenue goes here (Stellar public key)
FEE_WALLET=

# Wallets allowed into the admin panel, comma-separated. An allowlist, not a
# key: admin panel access proves wallet ownership by signature and grants no
# contract privilege. The vault's `admin` role — set_limits, add_quoter,
# remove_quoter — is a separate on-chain account whose key must NEVER be in a
# deployment environment. See docs/SECURITY.md.
ADMIN_WALLETS=

# SSL: set to false only for Supabase connection pooler in dev
DB_SSL_REJECT_UNAUTHORIZED=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Risk monitoring alerts (P1-7) — both channels optional, both best-effort.
# Slack incoming webhook:
MONITOR_SLACK_WEBHOOK_URL=
# Email via Resend (https://resend.com). Comma-separate multiple recipients:
RESEND_API_KEY=
MONITOR_ALERT_EMAIL_TO=
MONITOR_ALERT_EMAIL_FROM=Lusty Monitor <alerts@lusty.finance>
# Label shown in every alert (e.g. testnet / mainnet):
MONITOR_ENV_LABEL=testnet
# Secret for the scheduled endpoints (/api/cron/monitor, /api/cron/settle).
# Vercel cron sends it as a Bearer token; unset = endpoints disabled (fail
# closed):
CRON_SECRET=

# Key the settlement runner signs with (/api/cron/settle). It closes expired
# positions so writers do not have to send the transaction themselves.
#
# This key holds no privilege. `settle` is permissionless: the contract checks
# no caller identity, pays the position's owner, and prices the outcome off the
# oracle reading at expiry — so this account can only pay fees. It cannot move
# collateral, settle to itself, change a limit or sign a premium. Losing it
# costs the fee balance and nothing else, and while it is missing anyone,
# including the writer, can still settle. Unset = the sweep scans and reports
# but submits nothing.
SETTLE_RUNNER_SECRET=
# Monitor thresholds:
MONITOR_CAP_WARN_PCT=90
MONITOR_LATENCY_BUDGET_MS=4000
MONITOR_VOL_SPIKE_MULT=2
# Auto circuit-breaker halt thresholds (P1-8 step 2):
MONITOR_VOL_HALT_MULT=3
MONITOR_ORACLE_JUMP_PCT=10
MONITOR_EPOCH_LOSS_CAP_USD=25000
